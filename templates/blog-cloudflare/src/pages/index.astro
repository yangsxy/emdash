---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings, { entries: hotPosts }] =
	await Promise.all([
		getEmDashCollection("posts", {
			orderBy: { published_at: "desc" },
			limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
		}),
		getSiteSettings(),
		getEmDashCollection("posts", {
			orderBy: { published_at: "desc" },
			limit: 5,
		}),
	]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>
	<header class="band intro">
		<div class="frame home-intro">
			<div>
				<p class="eyebrow">Blog</p>
				<h1 class="intro__title">{siteTitle}</h1>
				{siteTagline && <p class="intro__subtitle">{siteTagline}</p>}
			</div>
			<a
				href="/rss.xml"
				type="application/rss+xml"
				class="btn btn--ghost btn--sm home-intro__rss"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
				RSS feed
			</a>
		</div>
	</header>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">No posts yet</h2>
						<p class="empty-state__text">
							Create your first post in the admin panel.
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								Create a post
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="band section" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="latest-posts" class="section-head__title">
									Latest posts
								</h2>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link">
										View all<span class="sr-only"> posts</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}

				{hotPosts.length > 0 && (
					<section class="band section" aria-labelledby="hot-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="hot-posts" class="section-head__title">
									一周热门排行
								</h2>
							</div>
							<ol class="hot-rank">
								{hotPosts.map((p, i) => (
									<li class="hot-rank__item">
										<span
											class={`hot-rank__no hot-rank__no--${i + 1}`}
										>
											{i + 1}
										</span>
										<a
											href={`/posts/${p.data.slug ?? p.data.id}`}
											class="hot-rank__t"
										>
											{p.data.title}
										</a>
										{p.data.views != null && (
											<span class="hot-rank__v">
												阅读 ({p.data.views})
											</span>
										)}
									</li>
								))}
							</ol>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	.home-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--spacing-6) var(--spacing-8);
	}

	/* Lifts the pill from the line box's bottom onto the last line's baseline */
	.home-intro__rss {
		margin-block-end: var(--spacing-2);
	}

	/* 一周热门排行 */
	.hot-rank {
		list-style: none;
		display: grid;
		gap: 2px;
		background: var(--color-surface);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
		padding: var(--spacing-2) var(--spacing-5);
	}

	.hot-rank__item {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.hot-rank__item:last-child {
		border-bottom: 0;
	}

	.hot-rank__no {
		width: 22px;
		height: 22px;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 3px;
		color: #fff;
		font-size: 12px;
		font-weight: 700;
		background: var(--color-muted);
	}

	.hot-rank__no--1 {
		background: var(--color-brand);
	}

	.hot-rank__no--2 {
		background: #5cb85c;
	}

	.hot-rank__no--3 {
		background: #428bca;
	}

	.hot-rank__t {
		flex: 1;
		min-width: 0;
		font-size: 15px;
		color: var(--color-text);
		text-decoration: none;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hot-rank__t:hover {
		color: var(--color-brand);
	}

	.hot-rank__v {
		font-size: 12px;
		color: var(--color-muted);
		flex: none;
	}

	@media (max-width: 720px) {
		.home-intro {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-intro__rss {
			justify-self: start;
			margin-block-end: 0;
		}
	}
</style>
