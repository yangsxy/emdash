---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { getEmDashCollection } from "emdash";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const menuItems = menu?.items ?? [];

// Build public page context for plugin contributions
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== "/" && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = getSiteLocale() ?? "en";
const monogram = [...siteTitle.trim()][0]?.toUpperCase() ?? "";
const year = new Date().getFullYear();

// Portal colour dots for the left-nav categories
const NAV_COLORS = [
	"#F0655A",
	"#428BCA",
	"#5CB85C",
	"#E0A800",
	"#9b59b6",
	"#e67e22",
];
function navColor(i: number): string {
	return NAV_COLORS[i % NAV_COLORS.length];
}

// Right sidebar "随机推荐": latest posts (CMS-driven)
const [{ entries: recPosts }] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	}),
]);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>

		<div class="portal">
			{/* ===== 左栏：Logo + 导航 + 搜索 + 社交 + 广告 ===== */}
			<aside class="portal__aside portal__left">
				<a href="/" class="portal__logo" aria-label={siteTitle}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<span class="portal__logo-mark" aria-hidden="true">
									{monogram}
								</span>
								<span class="portal__logo-name">{siteTitle}</span>
							</>
						)
					}
				</a>

				{
					menuItems.length > 0 && (
						<nav class="portal__nav" aria-label="Main">
							<ul>
								{menuItems.map((item, i) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
											aria-current={navCurrent(item.url)}
										>
											<span
												class="portal__nav-dot"
												style={`background:${navColor(i)}`}
												aria-hidden="true"
											/>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}

				<div class="portal__search portal__box">
					<LiveSearch
						placeholder="输入关键字"
						class="portal__search-field"
						inputClass="portal__search-input"
						resultsClass="portal__search-results"
						resultClass="portal__search-result"
						collections={["posts", "pages"]}
					/>
				</div>

				<div class="portal__social portal__box">
					<h4>关注我们</h4>
					<div class="portal__social-grid">
						<a href="/rss.xml"><span class="dot" style="background:#E6162D" />RSS订阅</a>
						<a href="#"><span class="dot" style="background:#428BCA" />微博</a>
						<a href="#"><span class="dot" style="background:#5CB85C" />微信</a>
						<a href="#"><span class="dot" style="background:#E0A800" />腾讯微博</a>
					</div>
				</div>

				<div class="portal__ad portal__box">
					<a href="#">广告链接一</a> <a href="#">广告链接二</a> 广告链接
				</div>

				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="portal__admin">进入后台</a>
					)
				}
			</aside>

			{/* ===== 中栏：页面内容 ===== */}
			<main id="main" tabindex="-1">
				<slot />
			</main>

			{/* ===== 右栏：作者简介 + 搜索 + 随机推荐 + 广告 ===== */}
			<aside class="portal__aside portal__right">
				<section class="portal__box portal__widget">
					<span class="portal__widget-tag">作者简介</span>
					<h3 class="portal__widget-title">{siteTitle}</h3>
					<p class="portal__widget-desc">
						{siteTagline ||
							"在后台基本信息中的“个人简介”里添加文字内容，向访客介绍你自己或这个站点。"}
					</p>
				</section>

				<section class="portal__box portal__widget">
					<h3 class="portal__widget-head">搜索</h3>
					<form class="portal__search2" action="/search" method="get">
						<input
							type="text"
							name="q"
							placeholder="输入关键字"
							aria-label="搜索"
						/>
						<button type="submit">搜索</button>
					</form>
				</section>

				<section class="portal__box portal__widget">
					<h3 class="portal__widget-head">随机推荐</h3>
					<ul class="portal__recs">
						{
							recPosts.map((p) => (
								<li class="portal__rec">
									<a href={`/posts/${p.data.slug ?? p.data.id}`} class="portal__rec-link">
										<span class="portal__rec-t">{p.data.title}</span>
										{p.data.views != null && (
											<span class="portal__rec-v">阅读({p.data.views})</span>
										)}
									</a>
									<span class="portal__rec-thumb" aria-hidden="true" />
								</li>
							))
						}
						{
							recPosts.length === 0 && (
								<li class="portal__rec-empty">暂无文章</li>
							)
						}
					</ul>
				</section>

				<div class="portal__ad-big">ADS (360×120)<br />广告位</div>
			</aside>
		</div>

		<footer class="site-footer band">
			<div class="frame site-footer__grid">
				<div class="site-footer__brand">
					<a href="/" class="brand">
						{
							siteLogo ? (
								<img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									class="brand__logo"
								/>
							) : (
								<>
									{monogram && (
										<span class="brand__mark" aria-hidden="true">
											{monogram}
										</span>
									)}
									<span class="brand__name">{siteTitle}</span>
								</>
							)
						}
					</a>
					{siteTagline && <p class="site-footer__tagline">{siteTagline}</p>}
				</div>
				{
					menuItems.length > 0 && (
						<nav class="site-footer__col" aria-labelledby="footer-navigate">
							<h2 id="footer-navigate" class="eyebrow">
								Navigate
							</h2>
							<ul class="site-footer__links">
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-footer__col">
					<h2 class="eyebrow">Connect</h2>
					<ul class="site-footer__links">
						<li>
							<a href="/rss.xml">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><path d="M4 11a9 9 0 0 1 9 9"></path><path
										d="M4 4a16 16 0 0 1 16 16"></path><circle
										cx="5"
										cy="19"
										r="1"></circle></svg
								>
								RSS feed
							</a>
						</li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__widgets">
					<WidgetArea name="footer" />
				</div>
			</div>
			<div class="band site-footer__bottom">
				<div class="frame site-footer__bottom-inner">
					<p class="site-footer__meta">
						{`© ${year} ${siteTitle}.`} Powered by{" "}
						<a href="https://emdashcms.com">EmDash</a>
					</p>
					<div class="theme-switcher" role="group" aria-label="Color theme">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><circle cx="12" cy="12" r="4"></circle><path
									d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><path
									d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><rect x="2" y="3" width="20" height="14" rx="2"></rect><path
									d="M8 21h8M12 17v4"></path></svg
							>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style is:global>
	@layer base;

	@layer base {
		*:where(:not([class*="emdash"]):not([class*="ec-"])),
		*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
		*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
			box-sizing: border-box;
		}

		body,
		h1,
		h2,
		h3,
		h4,
		h5,
		h6,
		p,
		ul,
		ol,
		figure,
		blockquote,
		dl,
		dd {
			margin: 0;
		}

		ul,
		ol {
			padding: 0;
		}

		@supports (color: light-dark(#000, #fff)) {
			:root.light {
				color-scheme: light;
			}

			:root.dark {
				color-scheme: dark;
			}
		}

		html {
			scroll-behavior: smooth;
			-webkit-text-size-adjust: 100%;
		}

		:target {
			scroll-margin-block-start: var(--spacing-6);
		}

		body {
			display: flex;
			flex-direction: column;
			min-height: 100vh;
			font-family: var(--font-body);
			font-size: 14px;
			line-height: 1.7;
			color: var(--color-text);
			background: var(--color-bg);
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		body::before {
			content: "";
			position: fixed;
			inset-block: 0;
			inset-inline: 0;
			z-index: -1;
			width: var(--frame-width);
			margin-inline: auto;
			border-inline: 1px solid var(--color-border);
			pointer-events: none;
		}

		main {
			min-width: 0;
		}

		main:focus {
			outline: none;
		}

		a:where(:not([class*="emdash"]):not([class*="ec-"])) {
			color: var(--color-brand);
			text-decoration-line: underline;
			text-decoration-thickness: 1px;
			text-decoration-color: var(--color-border-strong);
			text-underline-offset: 0.2em;
			transition:
				color var(--transition-fast),
				text-decoration-color var(--transition-fast);
		}

		a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
			text-decoration-color: currentColor;
		}

		:where(:not([class*="emdash"]):not([class*="ec-"])):focus-visible {
			outline: 2px solid var(--color-brand);
			outline-offset: 2px;
		}

		img {
			max-width: 100%;
			height: auto;
			display: block;
		}

		h1,
		h2,
		h3,
		h4,
		h5,
		h6 {
			font-family: var(--font-heading);
			line-height: var(--leading-tight);
			font-weight: var(--font-weight-heading);
			letter-spacing: var(--tracking-snug);
			text-wrap: balance;
			overflow-wrap: break-word;
		}

		h1 {
			font-weight: var(--font-weight-display);
			letter-spacing: var(--tracking-tight);
		}

		p {
			text-wrap: pretty;
		}

		kbd {
			font-family: var(--font-mono);
		}

		@media (prefers-reduced-motion: reduce) {
			html {
				scroll-behavior: auto;
			}

			*,
			*::before,
			*::after {
				transition-duration: 0.01ms !important;
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
			}
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
			border: 0;
		}

		.skip-link {
			position: fixed;
			top: var(--spacing-2);
			inset-inline-start: var(--spacing-2);
			z-index: 200;
			padding: var(--spacing-2) var(--spacing-4);
			border-radius: var(--radius-full);
			background: var(--color-brand);
			color: var(--color-on-brand);
			font-size: var(--font-size-sm);
			font-weight: 500;
			text-decoration: none;
			translate: 0 calc(-100% - var(--spacing-4));
			transition: translate var(--transition-fast);
		}

		.skip-link:focus-visible {
			translate: 0 0;
		}

		.frame {
			width: var(--frame-width);
			margin-inline: auto;
			padding-inline: var(--frame-padding);
		}

		.band {
			position: relative;
			border-top: 1px solid var(--color-border);
		}

		.section {
			padding-block: clamp(2rem, 1.5rem + 1.5vw, 3rem);
		}

		/* Center content should fill the portal column, not impose its own frame */
		.portal main :global(.frame) {
			width: auto;
			max-width: none;
			padding-inline: 0;
		}

		.portal main :global(.band) {
			border-top: 0;
		}

		.portal main :global(.band)::before,
		.portal main :global(.band)::after {
			content: none;
		}

		/* ===== Portal three-column layout (1:1 参考站) ===== */
		.portal {
			max-width: var(--frame-width);
			margin: 0 auto;
			padding: 18px 0 40px;
			display: grid;
			grid-template-columns: 170px minmax(0, 1fr) 250px;
			gap: 18px;
			align-items: start;
		}

		.portal__aside {
			display: flex;
			flex-direction: column;
			gap: 14px;
			position: sticky;
			top: 18px;
		}

		.portal__box {
			background: var(--color-surface);
			border-radius: var(--radius-sm);
			box-shadow: var(--shadow-sm);
		}

		/* Logo block (coral) */
		.portal__logo {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 18px 14px;
			background: var(--color-brand);
			color: #fff;
			border-radius: var(--radius-sm);
			text-decoration: none;
			font-weight: 700;
			font-size: 20px;
			letter-spacing: 1px;
		}

		.portal__logo img {
			height: 34px;
			width: auto;
			border-radius: var(--radius-sm);
		}

		.portal__logo-mark {
			display: grid;
			place-items: center;
			width: 34px;
			height: 34px;
			border-radius: 50%;
			border: 2px solid #fff;
			font-size: 16px;
			flex: none;
		}

		/* Left nav */
		.portal__nav {
			padding: 6px 0;
		}

		.portal__nav ul {
			list-style: none;
			display: grid;
		}

		.portal__nav a {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 11px 16px;
			color: var(--color-text);
